{
  "name": "gull-britannia",
  "private": true,
  "version": "2.0.0",
  "description": "Gull Britannia: a seagull stealth game in Dartmouth, 1967, on the SailSim River Dart engine",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.game.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node tests/e2e/missions.e2e.cjs"
  },
  "dependencies": {
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.10.3",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
